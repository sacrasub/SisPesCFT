# ─────────────────────────────────────────────────────────────────────────────
# SisPesCFT — Stack R$ 0 — Variáveis de Ambiente
# Copie este arquivo para `.env.local` e preencha os valores reais.
# NUNCA commite o arquivo .env.local no repositório.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend de dados ──────────────────────────────────────────────────────────
# "local"    → LocalStorage (padrão, funciona offline, sem conta)
# "supabase" → Supabase Postgres + Realtime (multiusuário)
NEXT_PUBLIC_DATA_BACKEND=local

# ── Supabase (necessário apenas quando DATA_BACKEND=supabase) ─────────────────
# Crie um projeto em https://supabase.com (plano Free inclui 500 MB e Realtime)
# Execute supabase/schema.sql no SQL Editor do seu projeto antes de usar.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# ── Resend (alertas por e-mail — plano Free: 3 000 e-mails/mês) ──────────────
# Crie uma conta em https://resend.com e gere uma API Key.
# O alerta é disparado via POST /api/notify quando uma escala cai para CRITICO.
# Deixe em branco para desativar silenciosamente (sem erro no client).
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX

# E-mail de destino dos alertas (Setor de Pessoal da CFT)
NOTIFY_EMAIL_TO=pessoal@cft.mar.mil.br

# ── Umami Analytics (sem cookies, LGPD-safe — plano Free: 10 000 eventos/mês) ─
# Crie uma conta em https://umami.is/cloud e adicione o site SisPesCFT.
# Deixe em branco para desativar o script de analytics.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ── Cloudflare Pages ──────────────────────────────────────────────────────────
# Deploy automático via GitHub: conecte o repositório em https://pages.cloudflare.com
# Comandos de build:
#   Build command:    npm run build
#   Output directory: .next
#   Node version:     20
# Para modo estático puro (sem API routes / Supabase server-side),
# descomente `output: "export"` em next.config.ts e use:
#   Build command:    npm run build
#   Output directory: out
# ─────────────────────────────────────────────────────────────────────────────
